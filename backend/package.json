    "backfill:user-fields": "tsx src/scripts/backfillUserFields.ts"
  },
  "dependencies": {
    "@ciphersprint/shared": "*",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.3",
    "random-words": "^2.0.1",
    "socket.io": "^4.8.3",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"

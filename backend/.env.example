MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ciphersprint
JWT_SECRET=replace-with-a-long-random-string
PORT=5000
CLIENT_ORIGIN=http://localhost:3001
GOOGLE_CLIENT_ID=
MEDIA_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password reset emails (https://resend.com). Without these the reset link is
# printed to this server's console instead.
RESEND_API_KEY=
MAIL_FROM=CipherSprint <no-reply@your-domain.com>
# Comma-separated usernames allowed to review reports at /admin/reports.
ADMIN_USERNAMES=
# Set to 1 behind a hosting proxy so rate limits see the real client IP.
TRUST_PROXY=
